---
// Calendar table. Rows come pre-processed from src/lib/events.js (status + dates).
// Columns collapse into stacked cards on small screens.
import { CAT_META, ORG_META, orgOf } from '../data/tournaments.js';
import { fmtDate } from '../lib/events.js';
const { rows = [], caption = '', id = 'tt', showDetails = true } = Astro.props;
const catSlug = (c) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<div class="table-wrap tt-wrap">
  <table id={id} class="tt">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">Event</th>
        <th scope="col">Where</th>
        <th scope="col">Dates</th>
        <th scope="col">Status</th>
        {showDetails && <th scope="col">Results, entry &amp; links</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((t) => {
        const om = ORG_META[t.org || orgOf(t.name)] || ORG_META.Other;
        const cm = CAT_META[t.category] || { bg: '#eef1ef', fg: '#15201A' };
        return (
          <tr data-status={t.status} data-cat={catSlug(t.category)} data-loc={t.inMalaysia === false ? 'overseas' : 'malaysia'}>
            <td data-label="Event">
              <strong class="tt-name">{t.name}</strong>
              <span class="tt-tags">
                <span class="org-badge" style={`background:${om.color}`}>{om.label}</span>
                <span class="cat-chip" style={`background:${cm.bg};color:${cm.fg}`}>{t.category}</span>
              </span>
            </td>
            <td data-label="Where">
              {t.venue}
              {t.inMalaysia === false
                ? <span class="loc-tag overseas">Overseas · Malaysian team/players</span>
                : <span class="loc-tag">In Malaysia</span>}
            </td>
            <td data-label="Dates" class="tt-dates">{t.dates}</td>
            <td data-label="Status"><span class={`chip ${t.status}`}>{t.status}</span></td>
            {showDetails && (
              <td data-label="Details" class="tt-details">
                {t.results?.length > 0 && (
                  <ul class="tt-results">
                    {t.results.map((r) => (
                      <li><span class="r-cat">{r.category}:</span> <strong>{r.winner}</strong>{r.runnerUp && <> d. {r.runnerUp}</>}{r.score && <> <span class="r-score">{r.score}</span></>}</li>
                    ))}
                  </ul>
                )}
                {t.note && <p class="tt-note-cell">{t.note}</p>}
                {t.entryDeadline && <p class="tt-entry">Entry deadline: <strong>{fmtDate(t.entryDeadline)}</strong></p>}
                <p class="tt-links">
                  {t.link && <a href={t.link} target="_blank" rel="noopener">Official page</a>}
                  {t.entryLink && <a href={t.entryLink} target="_blank" rel="noopener">Entry</a>}
                  {t.resultsLink && <a href={t.resultsLink} target="_blank" rel="noopener">Results{t.sourceLabel && !t.sourceUrl ? ` (${t.sourceLabel})` : ''}</a>}
                  {t.sourceUrl && t.sourceUrl !== t.link && t.sourceUrl !== t.resultsLink && <a href={t.sourceUrl} target="_blank" rel="noopener">{t.sourceLabel || 'Source'}</a>}
                  {t.reportUrl && <a href={t.reportUrl}>Our report</a>}
                </p>
              </td>
            )}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<style>
  .tt td{vertical-align:top}
  .tt-name{display:block;line-height:1.35}
  .tt-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
  .org-badge{display:inline-block;padding:2px 8px;border-radius:999px;color:#fff;font-size:11px;font-weight:700;letter-spacing:.02em;white-space:nowrap}
  .cat-chip{display:inline-block;padding:2px 9px;border-radius:999px;font-size:11.5px;font-weight:600;white-space:nowrap}
  .loc-tag{display:block;font-size:11.5px;color:#5A6862;margin-top:4px}
  .loc-tag.overseas{color:#3B2C8C;font-weight:600}
  .tt-dates{white-space:nowrap}
  .tt-details{font-size:14px;min-width:220px}
  .tt-results{list-style:none;margin:0 0 6px;padding:0}
  .tt-results li{margin:0 0 4px;line-height:1.4}
  .r-cat{color:#5A6862;font-size:12.5px}
  .r-score{font-family:var(--mono);font-size:12.5px;color:#36433C}
  .tt-note-cell,.tt-entry{margin:0 0 4px;font-size:13px;color:#36433C}
  .tt-links{display:flex;flex-wrap:wrap;gap:10px;margin:0;font-size:13px;font-weight:600}
  @media (max-width: 760px){
    .tt-wrap{overflow:visible;border:0}
    .tt thead{display:none}
    .tt, .tt tbody, .tt tr, .tt td{display:block;width:100%;min-width:0}
    .tt caption{display:block;text-align:left}
    .tt tr{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:0 0 12px;background:#fff}
    .tt td{border:0;padding:4px 0}
    .tt td[data-label="Where"]::before,.tt td[data-label="Dates"]::before{content:attr(data-label) ": ";font-weight:700;font-size:12px;color:#5A6862}
    .tt-dates{white-space:normal}
    .tt-details{min-width:0}
  }
</style>
