---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import PlayerDirectory from '../components/PlayerDirectory.astro';
import { ALL_PLAYERS, PLAYERS_CHECKED } from '../data/players.js';
import { SITE } from '../data/site-nav.js';
import { fmtDate } from '../lib/events.js';
const path='/malaysian-tennis-players/';
const title='Malaysian Tennis Players | Directory of Active, Junior & Retired Players';
const description='Directory of Malaysian tennis players: active pros, Davis Cup and BJK Cup players, top juniors and retired greats, with dated rankings and official profiles.';
const updated=fmtDate(PLAYERS_CHECKED);
const groups=[
  ['Active','Active players','Currently competing on the ATP, WTA or ITF circuits, in US college tennis or for Malaysia’s national teams.'],
  ['Junior','Juniors','Under-18 players. We publish public tennis information only.'],
  ['Retired','Retired and former players','Included for Malaysian tennis history.'],
].map(([k,l,d])=>({l,d,list:ALL_PLAYERS.filter((p)=>p.status===k)}));
const faqs=[
  {q:'Who is the highest-ranked Malaysian tennis player?',a:'On the ATP ranking of 2 November 2026, Mitsuki Leong was the highest-ranked Malaysian man at No. 408. On the WTA list of the same date, Shihomi Leong was the highest-ranked Malaysian woman at No. 1153. Rankings change weekly; see each profile for the date and source.'},
  {q:'Where can I find official Malaysian rankings?',a:'TennisMalaysia (the Lawn Tennis Association of Malaysia) publishes National Circuit and Junior Tour rankings about once a month at ltam.my/ranking.'},
  {q:'How do Malaysian players reach the professional tour?',a:'Most come through TennisMalaysia’s Junior Tour and National Circuit, then ITF junior events, before moving to ITF World Tennis Tour events (M15/W15 and up). Several now combine this with US college tennis.'},
];
const itemList={'@context':'https://schema.org','@type':'ItemList',name:'Malaysian tennis players',numberOfItems:ALL_PLAYERS.length,itemListElement:ALL_PLAYERS.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name,url:new URL(`/player-profiles/${p.gender}/${p.slug}/`,SITE.url).href}))};
const crumbs=[{name:'Home',href:'/'},{name:'Malaysian Players',href:path}];
---
<BaseLayout title={title} description={description} path={path} schema={[itemList]} updated={updated}>
  <div class="page-band"><div class="container"><Breadcrumbs items={crumbs} /><h1>Malaysian Tennis Players</h1><p class="intro">{ALL_PLAYERS.length} player profiles: who they are, where they compete and how they rank. Browse <a href="/player-profiles/men/">men</a> or <a href="/player-profiles/women/">women</a> separately.</p></div></div>
  <section class="section"><div class="container">
    <div class="prose" style="max-width:none">
      <div class="callout info"><strong>Three kinds of ranking appear on these pages:</strong> <strong>professional</strong> (ATP for men, WTA for women, updated weekly), <strong>junior</strong> (ITF World Tennis Tour Juniors, under-18) and <strong>national</strong> (TennisMalaysia’s National Circuit ranking, published about monthly). They are calculated differently and are always labelled. See the <a href="/tennis-ranking-guide/">ranking guide</a>.</div>
    </div>
    {groups.map((g)=>(
      <section class="grp" aria-label={g.l}>
        <h2>{g.l} <span class="n">({g.list.length})</span></h2>
        <p class="grp-d">{g.d}</p>
        <PlayerDirectory players={g.list} showGender />
      </section>
    ))}
  </div></section>
  <section class="section alt"><div class="container prose">
    <h2 id="pathway">The Malaysian player pathway</h2>
    <ol>
      <li><strong>Club and academy tennis</strong>, then the TennisMalaysia <strong>Junior Tour</strong> (12&amp;U–16&amp;U) and national junior championships.</li>
      <li><strong>ATF 14&amp;U</strong> events across Asia and Malaysia’s World Junior Tennis teams.</li>
      <li><strong>ITF junior events</strong> (J30–J300). Malaysia hosts several each year, including the J300 Premier Sarawak Cup.</li>
      <li><strong>National Circuit</strong> open events against senior players. Daania Hazli won the KL Open singles at 16.</li>
      <li><strong>ITF World Tennis Tour</strong> (M15/W15 and up) for the first ATP or WTA points, often combined with <strong>US college tennis</strong>, as Shihomi Leong (Pepperdine) and Darrshan Suresh Kumar (North Dakota) are doing.</li>
      <li>Selection for <strong>SUKMA</strong>, the <strong>SEA Games</strong>, and the <strong>Davis Cup</strong> or <strong>Billie Jean King Cup</strong>.</li>
    </ol>
    <p>For events at each level, see <a href="/malaysia-tennis-events/">how to choose and enter events</a> and the <a href="/tournaments/">2026 calendar</a>.</p>
    <Faq items={faqs} />
    <p class="callout">Profiles are compiled by the {SITE.name} Editorial Team from official ATP, WTA, ITF and TennisMalaysia sources, university rosters and news reports, and were last checked {updated}. Spotted an error or a player we should add? <a href="/contact/">Contact us</a>.</p>
    <div class="related callout info"><strong>Related:</strong> <a href="/tennis-ranking-guide/">Tennis ranking guide</a> · <a href="/news/">Latest news</a> · <a href="/atp-wta-malaysia-history/">ATP &amp; WTA history in Malaysia</a></div>
  </div></section>
  <style>
    .grp{margin-top:28px}
    .grp h2{font-size:24px;margin:0 0 4px}
    .grp .n{color:var(--slate);font-weight:500}
    .grp-d{color:var(--slate);font-size:15px;margin:0 0 14px}
  </style>
</BaseLayout>
