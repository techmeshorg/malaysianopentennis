  {y:2010,name:'Malaysian Open',d:'22–28 Feb',venue:'Bukit Kiara Equestrian & Country Resort',w:'Alisa Kleybanova',r:'Elena Dementieva',s:'6–3, 6–2'},
  {y:2011,name:'BMW Malaysian Open',d:'26 Feb–6 Mar',venue:'Bukit Kiara Equestrian & Country Resort',w:'Jelena Dokić',r:'Lucie Šafářová',s:'2–6, 7–6(9), 6–4'},
