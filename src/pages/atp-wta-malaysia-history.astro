  {y:2013,name:'BMW Malaysian Open',d:'24 Feb–3 Mar',venue:'Royal Selangor Golf Club',w:'Karolína Plíšková',r:'Bethanie Mattek-Sands',s:'1–6, 7–5, 6–3'},
  {y:2014,name:'BMW Malaysian Open',d:'12–20 Apr',venue:'Royal Selangor Golf Club',w:'Donna Vekić',r:'Dominika Cibulková',s:'5–7, 7–5, 7–6(4)'},
  {y:2015,name:'BMW Malaysian Open',d:'',venue:'Royal Selangor Golf Club',w:'Caroline Wozniacki',r:'Alexandra Dulgheru',s:'4–6, 6–2, 6–1',nodraw:true},
  {y:2016,name:'BMW Malaysian Open',d:'27 Feb–6 Mar',venue:'Royal Selangor Golf Club',w:'Elina Svitolina',r:'Eugenie Bouchard',s:'6–7(5), 6–4, 7–5'},
  {y:2017,name:'ALYA WTA Malaysian Open',d:'25 Feb–5 Mar',venue:'TPC Kuala Lumpur (formerly KLGCC), Bukit Kiara',w:'Ashleigh Barty',r:'Nao Hibino',s:'6–3, 6–2'},
