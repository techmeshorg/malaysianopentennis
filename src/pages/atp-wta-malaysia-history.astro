---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../data/site-nav.js';
const path='/atp-wta-malaysia-history/';
const title='ATP & WTA Tournaments in Malaysia | History, Venues & Champions';
const description='Every ATP and WTA tour event Malaysia has hosted, from the 1990s Kuala Lumpur events to the ATP Malaysian Open (2009–15) and WTA Malaysian Open (2010–17): years, venues, levels and champions, with sources.';
const updated='5 November 2026';

const WIKI_MO='https://en.wikipedia.org/wiki/Malaysian_Open_(tennis)';
const atp=(y)=>`https://www.atptour.com/en/scores/archive/kuala-lumpur/6003/${y}/results`;
const wta=(y)=>`https://wtafiles.wtatennis.com/pdf/draws/${y}/1041/MDS.pdf`;

const atpModern=[
  {y:2009,name:'Proton Malaysian Open',w:'Nikolay Davydenko',r:'Fernando Verdasco',s:'6–4, 7–5'},
  {y:2010,name:'Proton Malaysian Open',w:'Mikhail Youzhny',r:'Andrey Golubev',s:'6–7(7), 6–2, 7–6(3)'},
  {y:2011,name:'Proton Malaysian Open',w:'Janko Tipsarević',r:'Marcos Baghdatis',s:'6–4, 7–5'},
  {y:2012,name:'Proton Malaysian Open',w:'Juan Mónaco',r:'Julien Benneteau',s:'7–5, 4–6, 6–3'},
  {y:2013,name:'Proton Malaysian Open',w:'João Sousa',r:'Julien Benneteau',s:'2–6, 7–5, 6–4'},
  {y:2014,name:'Malaysian Open, Kuala Lumpur',w:'Kei Nishikori',r:'Julien Benneteau',s:'7–6(4), 6–4'},
  {y:2015,name:'Malaysian Open, Kuala Lumpur',w:'David Ferrer',r:'Feliciano López',s:'7–5, 7–5'},
];
const atp90s=[
  {y:'1993 (January)',name:'Kuala Lumpur',w:'Richey Reneberg',r:'Olivier Delaître',s:'6–3, 6–1',yr:1993},
  {y:'1993 (September)',name:'Kuala Lumpur Indoors (Salem Open)',w:'Michael Chang',r:'Jonas Svensson',s:'6–0, 6–4',yr:1993},
  {y:'1994',name:'Kuala Lumpur Open (Salem Open)',w:'Jacco Eltingh',r:'Andrei Olhovskiy',s:'7–6, 2–6, 6–4',yr:1994},
  {y:'1995',name:'Kuala Lumpur Open (Salem Open)',w:'Marcelo Ríos',r:'Mark Philippoussis',s:'7–6, 6–2',yr:1995},
];
