---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PlayerDirectory from '../../../components/PlayerDirectory.astro';
import { MEN, PLAYERS_CHECKED } from '../../../data/players.js';
import { SITE } from '../../../data/site-nav.js';
import { fmtDate } from '../../../lib/events.js';
const path='/player-profiles/men/';
const title="Malaysian Men's Tennis Players | Profiles, Rankings & Results";
const description="Directory of Malaysian men's tennis players: active, junior and retired, with dated rankings, recent results and links to official ATP, WTA and ITF profiles.";
const groups=[['Active','Active players'],['Junior','Juniors'],['Retired','Retired players']].map(([k,l])=>({l,list:MEN.filter((p)=>p.status===k)})).filter((x)=>x.list.length);
const crumbs=[{name:'Home',href:'/'},{name:'Malaysian Players',href:'/malaysian-tennis-players/'},{name:"Men's players",href:path}];
const itemList={'@context':'https://schema.org','@type':'ItemList',name:"Malaysian men's tennis players",numberOfItems:MEN.length,itemListElement:MEN.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name,url:new URL(`/player-profiles/men/${p.slug}/`,SITE.url).href}))};
---
<BaseLayout title={title} description={description} path={path} schema={[itemList]} updated={fmtDate(PLAYERS_CHECKED)}>
  <div class="page-band"><div class="container"><Breadcrumbs items={crumbs} /><h1>Malaysian Men's Tennis Players</h1><p class="intro">{MEN.length} profiles with rankings dated to their official release. See also <a href="/player-profiles/women/">women's players</a> and the <a href="/malaysian-tennis-players/">full Malaysian player directory</a>.</p></div></div>
  <section class="section"><div class="container">
    {groups.map((g)=>(<><h2 class="grp">{g.l}</h2><PlayerDirectory players={g.list} /></>))}
    <div class="prose" style="max-width:none;margin-top:22px">
      <div class="callout info">Rankings shown on cards are the latest official figures we checked ({fmtDate(PLAYERS_CHECKED)}), with the ranking date. Each profile links to the player's official ATP, WTA or ITF page for the live figure. Corrections welcome via our <a href="/contact/">Contact page</a>.</div>
    </div>
  </div></section>
  <style>.grp{font-size:22px;margin:26px 0 12px}.grp:first-child{margin-top:0}</style>
</BaseLayout>
